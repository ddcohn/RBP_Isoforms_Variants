# ---------------------------------------------------------------------------
# ClinVar-only: clinical significance / gene lookup table used by the
# ClinVar notebooks (joined in locally, not part of the prediction merge).
# ---------------------------------------------------------------------------

rule extract_clinvar_metadata:
    input:
        raw=ds("clinvar")["raw"],
        script=os.path.join(REPO, "splicing", "extract_clinvar_metadata.py"),
    output:
        out("clinvar", "metadata"),
    resources:
        mem_mb=8000,
        runtime=30,
    shell:
