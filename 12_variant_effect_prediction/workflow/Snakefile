# ---------------------------------------------------------------------------
# rbp_filter: RNP-machine-membership flags (fixed version -- see
# ../rbp_filter/README.md "RNP machine membership" for the 3 false-positive
# bugs this corrected). Modifies rbp_wt_list_with_go.tsv in place rather
# than writing a new file, so the rule's real output is tracked via a
# marker file instead of the modified-in-place table itself.
# ---------------------------------------------------------------------------

rule rnp_machine_flags:
    input:
        wt_list=SM["wt_rbp_list"],
        script=os.path.join(RBP_FILTER, "add_rnp_machine_flags.py"),
    output:
        marker=touch(RNP_FLAGS_MARKER),
    resources:
        mem_mb=4000,
        runtime=30,
    shell:
        "module load miniforge/23.11.0 && python3 {input.script}"
