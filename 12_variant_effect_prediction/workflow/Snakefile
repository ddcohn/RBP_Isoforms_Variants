        " && python3 {input.script} {input.raw} {output}"


# =============================================================================
# Saturation mutagenesis pipeline: full missense scan of the RBP list.
# Independent of everything above except sharing rbp_filter's merged table
# as an input to several late stages.
#
# NOTE on a real inconsistency, not hidden: unlike the clinvar/cmc scripts
# above (refactored to take paths as CLI args), the satmut scripts below
# still have their real output paths hardcoded as internal Python constants
# (written and run by hand, qsub job by qsub job, before this pipeline was
# extended to cover them). Every `output:` path declared below was checked
# to exactly match what each script actually writes -- Snakemake tracks
# correctness by output path, not by whether the script *received* that
# path as an argument, so this works, but config.yaml and each script's own
# hardcoded constants are two sources of truth that could drift apart if
# one is edited without the other. Refactoring these ~15 scripts to take
# CLI args (matching the clinvar/cmc pattern) would close that gap -- not
# done here to keep this extension's diff reviewable.
# =============================================================================

rule build_satmut_chunks:
    input:
        raw=SM["raw"],
        script=os.path.join(SM_SCRIPTS, "build_chunks_from_satmut_source.py"),
    output:
        satmut_chunk_fastas(),
        manifest=os.path.join(SDIR, "satmut_manifest.tsv"),
    resources:
        mem_mb=16000,
        runtime=60,
    shell:
        ACTIVATE.format(env=SPLICEAI_ENV) + " && python3 {input.script}"


SATMUT_DEEPLOC_CHECK = (
    " && n_in=$(grep -c '^>' {input.fasta})"
    " && n_out=$(($(wc -l < {output.outdir}/results_*.csv) - 1))"
    " && echo \"input=$n_in output=$n_out\""
    " && [ \"$n_out\" -ge \"$n_in\" ]"
)

rule predict_deeploc_satmut:
    input:
        fasta=os.path.join(SDIR, "satmut_chunks", "chunk_{schunk}.fasta"),
    output:
        outdir=directory(os.path.join(SDIR, "satmut_deeploc_results", "chunk_{schunk}")),
    resources:
        mem_mb=lambda wc, attempt: 24000 * attempt,
        runtime=lambda wc, attempt: 420 * attempt,  # DeepLoc satmut chunks run ~5.5-7h, longer than clinvar/cmc's
        sge_extra="-q gpu_RTX2080Ti.q,gpu_l40s.q@g18,gpu_l40s.q@g19,gpu_a100.q,gpu_h100.q,kappel_gpu.q -soft -q kappel_gpu.q,gpu_l40s.q,gpu_a100.q,gpu_h100.q -l cuda=1,require_gpu=1",
    retries: 4
    shell:
        ACTIVATE.format(env=DEEPLOC_ENV) +
        " && rm -rf {output.outdir}"
        " && deeploc2 -f {input.fasta} -o {output.outdir} -d cuda" +
        SATMUT_DEEPLOC_CHECK


SATMUT_PROTGPS_SCRIPT = os.path.join(LOC_COND, "protgps_predict_scale.py")

rule predict_protgps_satmut:
    input:
        fasta=os.path.join(SDIR, "satmut_chunks", "chunk_{schunk}.fasta"),
        script=SATMUT_PROTGPS_SCRIPT,
    output:
        os.path.join(SDIR, "satmut_protgps_results", "chunk_{schunk}.tsv"),
    resources:
        mem_mb=lambda wc, attempt: 24000 * attempt,
        runtime=360,
        sge_extra="-q kappel_gpu.q -l highp,require_gpu=1,cuda=1",
    retries: 3
    shell:
        ACTIVATE.format(env=PROTGPS_ENV) +
        " && python3 {input.script} {wildcards.schunk} {input.fasta} {output}"


rule predict_tango_satmut:
    input:
        fasta=os.path.join(SDIR, "satmut_chunks", "chunk_{schunk}.fasta"),
        script=os.path.join(SM_SCRIPTS, "tango_predict_chunk.py"),
    output:
        os.path.join(SDIR, "satmut_tango_results", "chunk_{schunk}.tsv"),
    params:
        tango_bin=SM["tango_binary"],
    resources:
        # TANGO's own per-sequence resumability means a Snakemake retry
        # just continues this exact chunk from wherever it stopped --
        # no separate backfill/escalation rule needed, unlike the
        # original hand-run pipeline's slow-chunk-escalation script.
        mem_mb=4000,
        runtime=lambda wc, attempt: 1440 * attempt,  # 24h, 48h, 72h, ...
        sge_extra=lambda wc, attempt: "" if attempt <= 1 else "-q kappel_cpu.q -l highp",
    retries: 5
    shell:
        "module load miniforge/23.11.0"
        " && python3 {input.script} {input.fasta} {output} {params.tango_bin}"


